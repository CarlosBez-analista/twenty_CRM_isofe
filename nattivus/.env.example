# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://nattivus:nattivus_dev@localhost:5433/nattivus_dev

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Qdrant ──────────────────────────────────────────
QDRANT_URL=http://localhost:6334

# ─── Auth / JWT ──────────────────────────────────────
JWT_PRIVATE_KEY=     # Ed25519 private key (PEM or base64)
JWT_PUBLIC_KEY=      # Ed25519 public key (PEM or base64)
JWT_ACCESS_TTL=900   # seconds (15 min)
JWT_REFRESH_TTL=604800  # seconds (7 days)

# ─── MFA / TOTP ─────────────────────────────────────
MFA_ENCRYPTION_KEY=  # 32 bytes hex for AES-256-GCM KEK

# ─── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
