  "data_flow": {
    "description": "Caminho de uma requisição HTTP do cliente até o banco",
    "flows": [
      {
        "id": "df-rest",
        "name": "Fluxo REST (leitura/escrita)",
        "steps": [
          { "n": 1, "actor": "Cliente HTTP", "action": "Envia requisição com Bearer token" },
          { "n": 2, "actor": "TenantContext Middleware", "action": "Extrai X-Workspace-Id do header → injeta no contexto" },
          { "n": 3, "actor": "RateLimitGuard", "action": "Verifica contador no Redis por IP/user" },
          { "n": 4, "actor": "AuthGuard", "action": "Valida JWT com JwtService.verify() → extrai userId + workspaceId" },
          { "n": 5, "actor": "PermissionGuard", "action": "Verifica permissões do usuário contra o manifesto do módulo" },
          { "n": 6, "actor": "DomainGuard", "action": "Valida se workspace tem domínio autorizado (se configurado)" },
          { "n": 7, "actor": "Controller", "action": "Recebe request tipado, chama service" },
          { "n": 8, "actor": "Service", "action": "Lógica de negócio + query ao Postgres com workspace_id filter" },
          { "n": 9, "actor": "AuditLogService", "action": "Grava ação crítica em audit_log (mutations)" },
          { "n": 10, "actor": "Controller", "action": "Serializa e retorna resposta JSON" }
        ],
        "file": "nattivus/packages/nattivus-shell/src/auth/"
      },
      {
        "id": "df-auth-login",
        "name": "Fluxo Auth — Login com MFA",
        "steps": [
          { "n": 1, "actor": "Cliente", "action": "POST /auth/login { email, password, deviceFingerprint }" },
          { "n": 2, "actor": "AuthController", "action": "UserService.findByEmail() → checa conta bloqueada" },
          { "n": 3, "actor": "PasswordService", "action": "Argon2id verify(hash, password) — timing-safe" },
          { "n": 4, "actor": "AuthController", "action": "Se MFA enrollado: retorna { requiresMfa: true, userId }" },
          { "n": 5, "actor": "Cliente", "action": "POST /auth/totp/verify { userId, token }" },
          { "n": 6, "actor": "TotpService", "action": "Verifica token TOTP ou backup code" },
          { "n": 7, "actor": "RefreshTokenService", "action": "Emite refresh token com rotação obrigatória" },
          { "n": 8, "actor": "JwtService", "action": "Assina access token JWT (sub, wid, roles)" },
          { "n": 9, "actor": "AuthController", "action": "Retorna { accessToken, refreshToken }" }
        ],
        "file": "nattivus/packages/nattivus-shell/src/auth/auth.controller.ts"
      },
      {
        "id": "df-module-discovery",
        "name": "Fluxo Module Discovery (Boot)",
        "steps": [
          { "n": 1, "actor": "main.ts", "action": "moduleDiscoveryService.discoverAll() no bootstrap" },
          { "n": 2, "actor": "ModuleDiscoveryService", "action": "fs.readdirSync(packages/modules/) — lista diretórios" },
          { "n": 3, "actor": "ModuleDiscoveryService", "action": "Para cada módulo: carrega dist/module.manifest.js (ou src/ em dev)" },
          { "n": 4, "actor": "ModuleDiscoveryService", "action": "isValidManifest() — valida shape obrigatório (moduleId, version, sdkVersion, entities, routes, permissions)" },
          { "n": 5, "actor": "ModuleDiscoveryService", "action": "semver.satisfies(SUPPORTED_SDK_VERSION, manifest.sdkVersion) — compatibilidade" },
          { "n": 6, "actor": "ModuleRegistryService", "action": "upsert(manifest) — INSERT ON CONFLICT UPDATE no module_registry" },
          { "n": 7, "actor": "main.ts", "action": "Loga resultados: N registered, M failed" }
        ],
        "file": "nattivus/packages/nattivus-shell/src/modules/module-discovery.service.ts"
      }
    ]
  },

