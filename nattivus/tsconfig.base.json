{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nattivus/shared": ["packages/nattivus-shared/src/index.ts"],
      "@nattivus/shared/*": ["packages/nattivus-shared/src/*"],
      "@nattivus/sdk": ["packages/nattivus-sdk/src/index.ts"],
      "@nattivus/sdk/*": ["packages/nattivus-sdk/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
