# .npmrc — configuração de publicação NPM para @nattivus/sdk
# Referência: T062

# Registry de destino (altere para registry privado se necessário)
registry=https://registry.npmjs.org/

# Autenticação (configure via variável de ambiente ou ~/.npmrc)
# NPM_TOKEN deve ser definido no CI:
#   echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" >> ~/.npmrc
