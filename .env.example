# NattivusECO local development
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/nattivus
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

JWT_PRIVATE_KEY_PATH=./.local/keys/ed25519-private.pem
JWT_PUBLIC_KEY_PATH=./.local/keys/ed25519-public.pem
JWT_KEY_ID=local-dev

APP_ENCRYPTION_KEY=change-me-32-byte-base64-value
